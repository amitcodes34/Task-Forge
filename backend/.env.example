# =============================================================================
# TaskForge – Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/taskforge_db"

# --- JWT ---
# Use a long, random, secret string (min 32 chars)
# JWT_SECRET is used by BOTH the REST API middleware AND the WebSocket auth middleware
# to verify tokens. Must be the same value as what you used to sign the token.
JWT_SECRET=your_super_secret_access_token_key_change_this
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_this
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend URL (for CORS and WebSocket connections) ---
# WebSocket (Socket.io) uses the same CORS origin as REST API
# The frontend connects to: ws://localhost:5000 (same port as the API)
CLIENT_URL=http://localhost:5173

# --- Email (Nodemailer / SMTP) ---
# For development, use Mailtrap: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM="TaskForge <noreply@taskforge.com>"

# --- Admin Seed (used by prisma/seed.js) ---
ADMIN_EMAIL=admin@taskforge.com
ADMIN_PASSWORD=Admin@TaskForge123

# --- WebSocket (Socket.io) ---
# No extra config needed — Socket.io attaches to the same PORT as the Express server.
# Frontend connects to ws://localhost:${PORT} automatically.
# Authentication: clients send their JWT as socket.handshake.auth.token
# Rooms: each project has its own room "project:<projectId>"

