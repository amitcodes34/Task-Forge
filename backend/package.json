{
  "name": "taskforge-backend",
  "version": "1.0.0",
  "description": "TaskForge – Freelance Project Marketplace API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "nodemon src/workers/emailWorker.js",
